{
  "name": "dsh-better-session",
  "version": "1.1.0",
  "description": "Batch session operations for DeepSeek Harness: multi-select archive and permanent delete, an archived-session manager, and redoing a completed turn in place.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/*.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session",
    "archive",
    "delete",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Terie412/dsh-better-session.git"
  },
  "bugs": {
    "url": "https://github.com/Terie412/dsh-better-session/issues"
  },
  "homepage": "https://github.com/Terie412/dsh-better-session#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node test/redo.mjs && node test/already-redone.mjs"
  }
}
